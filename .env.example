# API
PORT=8080
DATABASE_URL=postgres://pye:pye@localhost:5432/pye_learn?sslmode=disable
JWT_SECRET=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# Local: lax. Direct cross-origin (sin proxy): COOKIE_SECURE=true COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Web (Vite): vacío = same-origin vía proxy (vite.config / vercel.json → API).
# Solo setear si quieres pegarle directo a la API (rompe cookies en browsers modernos).
# VITE_API_URL=http://localhost:8080
